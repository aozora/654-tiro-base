    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^8.3.8",
    "vite-plugin-devtools-json": "^1.1.2"

    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-netlify": "^7.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tanstack/table-core": "^8.21.3",
    "@types/node": "^24.19.2",
    "auth": "^1.7.26",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^1.0.0-rc.5",
    "globals": "^16.5.0",
    "layerchart": "^2.11.0",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "sass": "^1.108.2",
    "svelte": "^5.58.0",
